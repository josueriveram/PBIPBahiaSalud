	/// Municipio de residencia registrado para el paciente.
	column Municipio
		dataType: string
		lineageTag: f4419c29-58e8-428b-a2f4-733248404a69
		summarizeBy: none
		sourceColumn: Municipio

		annotation SummarizationSetBy = Automatic

	/// Entidad promotora de salud a la que está afiliado el paciente.
	column EPS
