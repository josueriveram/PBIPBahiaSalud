	partition LocalDateTable_b003c781-ec1e-42ad-838a-96d42f50b014 = calculated
		mode: import
		source = Calendar(Date(Year(MIN('Atenciones'[Fecha_Egreso])), 1, 1), Date(Year(MAX('Atenciones'[Fecha_Egreso])), 12, 31))

