/// Calendario automático interno asociado a Atenciones[Fecha_Egreso]. Genera días desde el 1 de enero del año mínimo hasta el 31 de diciembre del año máximo de egreso para habilitar la jerarquía de fechas.
table LocalDateTable_b003c781-ec1e-42ad-838a-96d42f50b014
	isHidden
	showAsVariationsOnly
	lineageTag: 293f18f3-9019-4abb-a978-8fd8fe4f03ac

	/// Día del calendario automático asociado a Atenciones[Fecha_Egreso]. La tabla cubre años completos desde el mínimo hasta el máximo de esa fecha.
	column Date
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: b81c4961-4b5d-4dff-8baf-1b8942eefcd3
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	/// Año derivado de Date mediante YEAR([Date]); permite agrupar fechas de egreso por año.
	column Año = YEAR([Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a65ca776-2e10-4394-ac96-578ebb979af9
		dataCategory: Years
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Year

	/// Número de mes del 1 al 12, derivado de Date mediante MONTH([Date]); ordena los nombres de mes.
	column NroMes = MONTH([Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 99372998-0c40-4c97-8887-fa58b02315d7
		dataCategory: MonthOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = MonthNumber

	/// Nombre del mes derivado con FORMAT([Date], "MMMM"); se ordena por NroMes para mantener el orden del calendario.
	column Mes = FORMAT([Date], "MMMM")
		dataType: string
		isHidden
		lineageTag: 51e94b5b-da8b-4302-b42f-f3da0246f7f7
		dataCategory: Months
		summarizeBy: none
		sortByColumn: NroMes

		annotation SummarizationSetBy = User

		annotation TemplateId = Month

	/// Número de trimestre, calculado como INT(([NroMes] + 2) / 3); agrupa los meses en los trimestres 1 a 4.
	column NroTrimestre = INT(([NroMes] + 2) / 3)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 279e947e-3a4b-4624-9fa8-ea3a8401fed1
		dataCategory: QuarterOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = QuarterNumber

	/// Etiqueta del trimestre, construida como "Trim. " más NroTrimestre; se ordena por el número de trimestre.
	column Trimestre = "Trim. " & [NroTrimestre]
		dataType: string
		isHidden
		lineageTag: 210c3eae-3155-48c6-b94b-0ce55c0a5435
		dataCategory: Quarters
		summarizeBy: none
		sortByColumn: NroTrimestre

		annotation SummarizationSetBy = User

		annotation TemplateId = Quarter

	/// Día del mes derivado de Date mediante DAY([Date]); toma valores del 1 al 31 según la fecha.
	column Día = DAY([Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 676fb74a-2af9-4f5e-be8c-9d2b29bf3277
		dataCategory: DayOfMonth
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Day

	hierarchy 'Jerarquía de fechas'
