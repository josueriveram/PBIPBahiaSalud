/// Una fila por atención de salud. Contiene paciente, sede, fechas de ingreso y egreso, servicio, diagnóstico CIE-10 y médico. Paciente_ID y Sede_ID permiten relacionarla con Pacientes y Sedes.
table Atenciones
	lineageTag: dc655d0a-1f19-4049-947c-9958a46b17b5

	/// Identificador único de la atención de salud; permite distinguir cada registro de atención.
	column Atencion_ID
		dataType: string
		lineageTag: 2170d294-5918-44a7-92e9-6431c2031816
		summarizeBy: none
		sourceColumn: Atencion_ID

		annotation SummarizationSetBy = Automatic

	/// Identificador del paciente atendido. Se relaciona con Pacientes[Paciente_ID].
	column Paciente_ID
		dataType: string
		lineageTag: 3bc3650a-44a6-412a-a5e8-9c253af0dcba
		summarizeBy: none
		sourceColumn: Paciente_ID

		annotation SummarizationSetBy = Automatic

	/// Identificador de la sede donde ocurrió la atención. Se relaciona con Sedes[Sede_ID].
	column Sede_ID
