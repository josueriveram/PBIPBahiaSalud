		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Fecha en que termina la atención o estancia; se usa junto con Fecha_Ingreso para calcular su duración.
	column Fecha_Egreso
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4d056d54-07e8-440b-8166-bb5a8b8ae443
