	isHidden
	showAsVariationsOnly
	lineageTag: 8167ebec-5125-40ba-b35a-e088283e04e4

	/// Día del calendario automático asociado a Usuarios_Roles[Fecha_Retiro]. La tabla cubre años completos desde el mínimo hasta el máximo de esa fecha.
	column Date
