		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	/// Año derivado de Date mediante YEAR([Date]); permite agrupar fechas de retiro por año.
	column Año = YEAR([Date])
		dataType: int64
		isHidden
		formatString: 0
