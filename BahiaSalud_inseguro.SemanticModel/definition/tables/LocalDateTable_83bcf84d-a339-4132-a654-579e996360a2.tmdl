/// Calendario automático interno asociado a Atenciones[Fecha_Ingreso]. Genera días desde el 1 de enero del año mínimo hasta el 31 de diciembre del año máximo de ingreso para habilitar la jerarquía de fechas.
table LocalDateTable_83bcf84d-a339-4132-a654-579e996360a2
	isHidden
	showAsVariationsOnly
	lineageTag: 5ffab473-6a2d-4f9e-8616-a50d24792e39

	/// Día del calendario automático asociado a Atenciones[Fecha_Ingreso]. La tabla cubre años completos desde el mínimo hasta el máximo de esa fecha.
	column Date
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: eb8399e3-7d8a-4044-8426-32fa098ea438
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	/// Año derivado de Date mediante YEAR([Date]); permite agrupar fechas de ingreso por año.
	column Año = YEAR([Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3abdce1a-d726-47b9-872b-556ff4ac9afe
		dataCategory: Years
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Year

	/// Número de mes del 1 al 12, derivado de Date mediante MONTH([Date]); ordena los nombres de mes.
	column NroMes = MONTH([Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f6ee3446-73f2-4bad-b31e-e3554f4ed1e4
		dataCategory: MonthOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = MonthNumber

	/// Nombre del mes derivado con FORMAT([Date], "MMMM"); se ordena por NroMes para mantener el orden del calendario.
	column Mes = FORMAT([Date], "MMMM")
		dataType: string
		isHidden
		lineageTag: 5a85a6a8-7f64-4322-9059-5d9311f8155b
		dataCategory: Months
		summarizeBy: none
		sortByColumn: NroMes

		annotation SummarizationSetBy = User

		annotation TemplateId = Month

	/// Número de trimestre, calculado como INT(([NroMes] + 2) / 3); agrupa los meses en los trimestres 1 a 4.
	column NroTrimestre = INT(([NroMes] + 2) / 3)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d53aa6a1-0730-424a-af38-006ce40530e3
		dataCategory: QuarterOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = QuarterNumber

	/// Etiqueta del trimestre, construida como "Trim. " más NroTrimestre; se ordena por el número de trimestre.
	column Trimestre = "Trim. " & [NroTrimestre]
		dataType: string
		isHidden
		lineageTag: c05407f3-8e5b-4512-be47-a0200803321e
		dataCategory: Quarters
		summarizeBy: none
		sortByColumn: NroTrimestre

		annotation SummarizationSetBy = User

		annotation TemplateId = Quarter

	/// Día del mes derivado de Date mediante DAY([Date]); toma valores del 1 al 31 según la fecha.
	column Día = DAY([Date])
