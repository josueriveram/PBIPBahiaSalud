	isHidden
	showAsVariationsOnly
	lineageTag: 737041c6-6309-4ce0-9de8-22b3343af74c

	/// Día del calendario automático asociado a Pacientes[Fecha_Nacimiento]. La tabla cubre años completos desde el mínimo hasta el máximo de esa fecha.
	column Date
